# vps-toolkit 一键部署配置示例
# 复制到 /root/.vps-toolkit/deploy.env 并设置权限 600，不要提交到仓库。
# 格式：KEY=VALUE，每行一项；值可加引号，不支持行尾注释。
# 留空或删除的可选项会使用默认值或自动生成。

# ---------- 必填 ----------
REALITY_DOMAIN=myweb.example.com
HY2_DOMAIN=vps01.example.com
CDN_DOMAIN=cdn01.example.com
CF_TOKEN=

# ---------- AI 分流（六六云 SS） ----------
ENABLE_AI_ROUTE=y
SS_ISP_ADDR=
SS_ISP_PORT=
SS_ISP_PASS=
# SS_ISP_METHOD=2022-blake3-aes-256-gcm

# ---------- 可选 ----------
# REALITY_TARGET=myweb.example.com:443
# HY2_CERT_MODE=http
# ACME_EMAIL=
# NODE_NAME=vps01

# 面板（不填则随机生成）
# PANEL_PORT=
# PANEL_USER=
# PANEL_PASS=
# PANEL_PATH=

# 端口
# HY2_PORT=443
# HOP_RANGE=20000-20100
# REALITY_PORT=443
# XHTTP_PORT=30115
# CDN_PORT=8443

# 路径（不填则随机生成）
# CDN_WS_PATH=
# XHTTP_PATH=

# geodata 自动更新时间（cron，按服务器时区，通常为 UTC）；off 关闭
# GEODATA_CRON=0 20 * * *
